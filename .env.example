# Auth — Clerk (auto-provisioned by `vercel integration add clerk`, see docs/DECISIONS.md)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database — Neon Postgres (auto-provisioned by `vercel integration add neon`)
DATABASE_URL=

# Storage — Vercel Blob. The default store is public-only (required for
# client-side upload, dashboard/new/page.tsx). Rendered clip video/SRT/VTT
# and export ZIPs need private, signed-download access (FR-33/34) and so
# use a second, private-access store instead — see src/lib/blob.ts and
# docs/DECISIONS.md ("Cannot use private access on a public store", found
# 2026-10-02).
BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Worker (M2+) — Postgres-backed job queue, no separate broker needed.

# M3.5 — shared secret between the worker and /api/internal/* routes
# (machine-to-machine auth; these routes are deliberately outside proxy.ts's
# Clerk-protected matcher). Generate any long random string.
WORKER_INTERNAL_SECRET=

# M3.5 — AI Gateway (LLM moment detection, `ai` package). Auth defaults to
# OIDC (VERCEL_OIDC_TOKEN, written by `vercel env pull`); set this instead
# only for a non-Vercel environment or CI. NOT currently used — translation,
# shortening, and moment detection all call Groq/Gemini directly (below)
# instead of routing through Gateway. See docs/DECISIONS.md.
# AI_GATEWAY_API_KEY=

# 2026-10-01 — Groq, user-supplied free-tier key. PRIMARY provider for:
# translation/shortening/moment-detection text calls (src/lib/llm-models.ts)
# and worker/transcribe.py's STT (Whisper). See docs/DECISIONS.md.
GROQ_API_KEY=

# 2026-10-01 — Google Gemini, user-supplied free-tier key. FALLBACK for the
# three text LLM routes above, used only if Groq fails. See docs/DECISIONS.md.
GOOGLE_GENERATIVE_AI_API_KEY=

# M3.1 — hosted STT API key, read by worker/transcribe.py (not the Next.js
# app). Optional fallback only as of 2026-10-01 — Groq Whisper (above) is
# primary; this is reached only if GROQ_API_KEY is unset/fails AND this is
# set. See docs/DECISIONS.md.
# STT_API_KEY=

# M4.9 — HMAC secret for signed, expiring clip download links
# (/api/clips/:id/download, FR-33/FR-34). Falls back to
# WORKER_INTERNAL_SECRET if unset; set a distinct value in production so
# rotating one doesn't invalidate the other. See docs/DECISIONS.md.
# DOWNLOAD_SIGNING_SECRET=

# M6.2 — hosted TTS API key, read by worker/dub.py (not the Next.js app).
# Optional fallback only as of 2026-10-01 — edge-tts (free, no key needed)
# is primary; this is reached only if edge-tts raises AND this is set.
# See docs/DECISIONS.md.
# TTS_API_KEY=

# M8.4 — secures /api/cron/retention (Vercel Cron sends this as a bearer
# token automatically once set — see vercel.ts). Optional locally; the
# route allows unauthenticated calls when unset so `npm run dev` can hit it
# directly for testing.
# CRON_SECRET=
