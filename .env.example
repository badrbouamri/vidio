# Auth — Clerk (auto-provisioned by `vercel integration add clerk`, see docs/DECISIONS.md)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database — Neon Postgres (auto-provisioned by `vercel integration add neon`)
DATABASE_URL=

# Storage — Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Worker (M2+) — Postgres-backed job queue, no separate broker needed.

# M3.5 — shared secret between the worker and /api/internal/* routes
# (machine-to-machine auth; these routes are deliberately outside proxy.ts's
# Clerk-protected matcher). Generate any long random string.
WORKER_INTERNAL_SECRET=

# M3.5 — AI Gateway (LLM moment detection, `ai` package). Auth defaults to
# OIDC (VERCEL_OIDC_TOKEN, written by `vercel env pull`); set this instead
# only for a non-Vercel environment or CI. See docs/DECISIONS.md.
# AI_GATEWAY_API_KEY=

# M3.1 — hosted STT API key, read by worker/transcribe.py (not the Next.js
# app). See docs/DECISIONS.md.
# STT_API_KEY=

# M4.9 — HMAC secret for signed, expiring clip download links
# (/api/clips/:id/download, FR-33/FR-34). Falls back to
# WORKER_INTERNAL_SECRET if unset; set a distinct value in production so
# rotating one doesn't invalidate the other. See docs/DECISIONS.md.
# DOWNLOAD_SIGNING_SECRET=
